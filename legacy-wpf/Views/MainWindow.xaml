<Window x:Class="AuroraLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:AuroraLauncher.Core"
        Title="Aurora Launcher" Height="640" Width="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Сайдбар ===================== -->
        <Border Grid.Column="0" Background="{StaticResource Panel}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="14" Height="14" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <Ellipse Width="14" Height="14" Fill="{StaticResource Accent2}" Margin="-4,0,0,0" Opacity="0.8" VerticalAlignment="Center"/>
                        <TextBlock Text="Aurora" FontSize="21" FontWeight="Bold" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="личный лаунчер Minecraft" FontSize="11" Foreground="{StaticResource Muted}" Margin="1,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,16,0,0">
                    <RadioButton x:Name="NavHome" Content="🏠  Главная" GroupName="nav" Style="{StaticResource NavBtn}" IsChecked="True" Checked="NavHome_Checked"/>
                    <RadioButton x:Name="NavVersions" Content="📦  Версии" GroupName="nav" Style="{StaticResource NavBtn}" Checked="NavVersions_Checked"/>
                    <RadioButton x:Name="NavMods" Content="🧩  Моды" GroupName="nav" Style="{StaticResource NavBtn}" Checked="NavMods_Checked"/>
                    <RadioButton x:Name="NavSettings" Content="⚙  Настройки" GroupName="nav" Style="{StaticResource NavBtn}" Checked="NavSettings_Checked"/>
                </StackPanel>

                <!-- Аккаунт + играть -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Card}" Margin="10,10,10,10" CornerRadius="12" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource Accent}">
                                <TextBlock x:Name="AvatarChar" Text="?" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                                <TextBlock x:Name="AccountName" Text="Не выполнен вход" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="AccountStatus" Text="Microsoft аккаунт" FontSize="11" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                            <Button x:Name="AccountBtn" Grid.Column="2" Content="Войти" Style="{StaticResource GhostBtn}"
                                    Padding="10,5" FontSize="12" Click="AccountBtn_Click"/>
                        </Grid>
                        <Button x:Name="PlayBtn" Content="▶  ИГРАТЬ" Style="{StaticResource PrimaryBtn}" Margin="0,12,0,0"
                                FontSize="16" Padding="0,11" Click="PlayBtn_Click"/>
                    </StackPanel>
                </Border>

                <StackPanel VerticalAlignment="Bottom" Margin="18,0,18,8">
                    <TextBlock x:Name="VersionText" Text="Aurora Launcher 1.0" FontSize="10" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Контент ===================== -->
        <Grid Grid.Column="1" Margin="24,20,24,12">

            <!-- Главная -->
            <Grid x:Name="PageHome">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Мои сборки" FontSize="20" FontWeight="SemiBold"/>
                <ListBox x:Name="InstanceList" Grid.Row="1" Margin="0,14,0,0" Background="Transparent"
                         BorderThickness="0" SelectionChanged="InstanceList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:Instance}">
                            <Border Background="{StaticResource Card}" CornerRadius="12" Padding="14" Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="46" Height="46" CornerRadius="10" Background="{StaticResource Panel}">
                                        <TextBlock Text="{Binding Icon}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="🗑" Style="{StaticResource GhostBtn}" Padding="8,4"
                                            Click="DeleteInstance_Click" ToolTip="Удалить сборку"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="HomeStatus" Text="" Foreground="{StaticResource Muted}" Margin="0,8,0,2" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="HomeBar" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- Версии -->
            <Grid x:Name="PageVersions" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Новая сборка" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                               Text="Выберите версию Minecraft и загрузчик. Файлы скачиваются только с официальных серверов Mojang, Forge, NeoForge и Fabric."/>
                </StackPanel>
                <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="14" Padding="18" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Загрузчик" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="LoaderCombo" SelectionChanged="LoaderCombo_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Версия Minecraft" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="McVersionCombo" SelectionChanged="McVersionCombo_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Версия загрузчика" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="LoaderVersionCombo"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InstanceNameBox" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="CreateBtn" Content="Создать сборку" Style="{StaticResource PrimaryBtn}"
                                    Margin="12,0,0,0" Click="CreateInstance_Click"/>
                        </Grid>
                        <TextBlock x:Name="InstanceNameHint" Text="Название сборки (оставьте пустым для автоматического)" FontSize="11"
                                   Foreground="{StaticResource Muted}" Margin="2,6,0,0"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="VersionsStatus" Text="" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </Grid>

            <!-- Моды -->
            <Grid x:Name="PageMods" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Моды" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ModsTargetText" Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                               Text="Выберите сборку на главной вкладке — моды установятся в неё."/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ModSourceCombo" Width="150" SelectionChanged="ModSource_SelectionChanged">
                        <ComboBoxItem Content="Modrinth" IsSelected="True"/>
                        <ComboBoxItem Content="CurseForge"/>
                    </ComboBox>
                    <TextBox x:Name="ModSearchBox" Grid.Column="2" Width="420" KeyDown="ModSearch_KeyDown"/>
                    <Button x:Name="ModSearchBtn" Grid.Column="4" Content="Найти" Style="{StaticResource PrimaryBtn}"
                            Margin="10,0,0,0" Click="ModSearch_Click"/>
                </Grid>
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="ModResults" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Card}" CornerRadius="12" Padding="12" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🧩" FontSize="24" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource Muted}"
                                                       Text="{Binding Author, StringFormat=автор: {0}}"/>
                                            <TextBlock FontSize="12" Foreground="{StaticResource Muted}" Text="{Binding Description}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Content="Установить" Style="{StaticResource PrimaryBtn}" Padding="12,6"
                                                    Click="InstallMod_Click"/>
                                            <TextBlock Text="{Binding Downloads}" FontSize="11" Foreground="{StaticResource Muted}"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Установленные" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListBox x:Name="InstalledModsList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Card}" CornerRadius="8" Padding="10,6" Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostBtn}" Padding="6,2"
                                                    Click="DeleteMod_Click" ToolTip="Удалить мод"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Настройки -->
            <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Настройки" FontSize="20" FontWeight="SemiBold"/>
                    <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Память для игры" FontWeight="SemiBold"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="RamSlider" Minimum="1024" Maximum="16384" TickFrequency="512"
                                        IsSnapToTickEnabled="True" Value="4096" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RamText" Grid.Column="1" Text="4096 МБ" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Java" FontWeight="SemiBold"/>
                            <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,8"
                                       Text="Оставьте пустым — лаунчер сам найдёт подходящую Java или скачает официальный рантайм Mojang."/>
                            <TextBox x:Name="JavaPathBox"/>
                            <Button Content="Выбрать java.exe вручную" Style="{StaticResource GhostBtn}" Margin="0,8,0,0"
                                    HorizontalAlignment="Left" Click="PickJava_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Окно игры" FontWeight="SemiBold"/>
                            <CheckBox x:Name="ResCheck" Content="Задать размер окна" Margin="0,8,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="WidthBox" Width="90" Text="854"/>
                                <TextBlock Text="×" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                <TextBox x:Name="HeightBox" Width="90" Text="480"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Дополнительно" FontWeight="SemiBold"/>
                            <TextBlock Text="Дополнительные аргументы JVM" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,4"/>
                            <TextBox x:Name="JvmArgsBox"/>
                            <TextBlock Text="CurseForge API-ключ (для вкладки модов)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,4"/>
                            <TextBox x:Name="CurseKeyBox"/>
                            <TextBlock Text="Свой Azure client_id (пусто — встроенный публичный)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,4"/>
                            <TextBox x:Name="ClientIdBox"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Сохранить настройки" Style="{StaticResource PrimaryBtn}" Click="SaveSettings_Click"/>
                        <Button Content="Открыть папку лаунчера" Style="{StaticResource GhostBtn}" Margin="10,0,0,0" Click="OpenFolder_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="SettingsStatus" Text="" Foreground="{StaticResource Accent2}" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
