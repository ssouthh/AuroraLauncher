<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AuroraLauncher.DebugConsoleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Aurora Launcher — Консоль отладки">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель управления -->
        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE756;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="ConsoleHeaderTitle" Text="Живая консоль отладки" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />

                    <TextBox x:Name="SearchBox"
                             PlaceholderText="Фильтр по ключевому слову..."
                             Width="220"
                             Height="32"
                             TextChanged="SearchBox_TextChanged"
                             Margin="12,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ToggleButton x:Name="AutoScrollToggle" IsChecked="True" Content="Автопрокрутка" Height="32" />
                    <Button x:Name="CopyLogsBtn" Click="CopyLogs_Click" Content="Копировать всё" Height="32" />
                    <Button x:Name="ClearLogsBtn" Click="ClearLogs_Click" Content="Очистить" Height="32" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Текстовое поле логов -->
        <ScrollViewer x:Name="LogScrollViewer"
                      Grid.Row="1"
                      Padding="16"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <TextBox x:Name="ConsoleTextBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas, Cascadia Code, Courier New"
                     FontSize="12"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="0" />
        </ScrollViewer>

        <!-- Нижний статус-бар -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <TextBlock x:Name="StatusText" Text="Подключено к потоку логов" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="LineCountText" Text="0 строк" HorizontalAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
