<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuroraLauncher.Pages.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer x:Name="ModsScrollViewer" Padding="36,24,36,36" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1080" Spacing="20">

                <!-- Заголовок страницы и выбор сборки -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE896;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ModsPageTitle" Style="{ThemeResource TitleTextBlockStyle}" Text="Центр Модов и Оптимизации" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="ModsPageSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource BodyTextBlockStyle}" Text="Бесконечный каталог Modrinth и CurseForge, управление и 1-клик ускорение FPS" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Выбор сборки -->
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71D;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="InstanceSelectorLabel" Text="Сборка:" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="InstanceSelectorComboBox" Width="200" SelectionChanged="InstanceSelectorComboBox_SelectionChanged" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- InfoBar для уведомлений -->
                <InfoBar x:Name="ModsInfoBar" IsOpen="False" IsClosable="True" />

                <!-- Верхние вкладки навигации (Каталог / Установленные / 1-Клик Ускоритель) -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="TabCatalogBtn" Grid.Column="0" Click="TabCatalogBtn_Click" HorizontalAlignment="Stretch" Height="42" Style="{ThemeResource AccentButtonStyle}" Padding="6,0">
                            <Grid ColumnSpacing="6" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE721;" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock x:Name="TabCatalogText" Grid.Column="1" Text="🔍 Каталог модов" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </Grid>
                        </Button>

                        <Button x:Name="TabInstalledBtn" Grid.Column="1" Click="TabInstalledBtn_Click" HorizontalAlignment="Stretch" Height="42" Padding="6,0">
                            <Grid ColumnSpacing="6" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xED25;" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock x:Name="TabInstalledText" Grid.Column="1" Text="📦 Установленные моды (0)" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </Grid>
                        </Button>

                        <Button x:Name="TabBoosterBtn" Grid.Column="2" Click="TabBoosterBtn_Click" HorizontalAlignment="Stretch" Height="42" Padding="6,0">
                            <Grid ColumnSpacing="6" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE945;" FontSize="15" Foreground="#FFD700" VerticalAlignment="Center" />
                                <TextBlock x:Name="TabBoosterText" Grid.Column="1" Text="⚡ 1-Клик Ускоритель FPS" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <!-- ================== ВКЛАДКА 1: КАТАЛОГ МОДОВ (С БЕСКОНЕЧНОЙ ЛЕНТОЙ) ================== -->
                <StackPanel x:Name="CatalogViewPanel" Spacing="16">
                    <!-- Поисковая панель -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="ModSearchBox"
                                     PlaceholderText="Поиск мода (например: Sodium, Iris, JEI, JourneyMap...)"
                                     Height="38"
                                     KeyDown="ModSearchBox_KeyDown" />

                            <ComboBox x:Name="ModSourceComboBox" Grid.Column="1" HorizontalAlignment="Stretch" Height="38" SelectionChanged="ModSourceComboBox_SelectionChanged">
                                <ComboBoxItem Content="Modrinth" IsSelected="True" />
                                <ComboBoxItem Content="CurseForge" />
                            </ComboBox>

                            <Button x:Name="SearchModsButton" Grid.Column="2" Click="SearchModsButton_Click" Style="{ThemeResource AccentButtonStyle}" Height="38" Padding="18,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                                    <TextBlock x:Name="SearchModsButtonText" Text="Найти" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="OpenModsFolderBtn" Grid.Column="3" Click="OpenModsFolderBtn_Click" Height="38" Padding="14,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xED25;" FontSize="14" />
                                    <TextBlock x:Name="OpenModsFolderBtnText" Text="Папка mods" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Заголовок каталога и статус загрузки -->
                    <Grid>
                        <TextBlock x:Name="SearchResultsHeaderText" Text="Популярные моды" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <ProgressRing x:Name="SearchProgressRing" HorizontalAlignment="Right" Width="22" Height="22" IsActive="False" Visibility="Collapsed" />
                    </Grid>

                    <!-- Лента модов -->
                    <StackPanel x:Name="SearchResultsPanel" Spacing="8" />

                    <!-- Индикатор дозагрузки (бесконечная лента) -->
                    <StackPanel x:Name="LoadingMorePanel" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Padding="16" Visibility="Collapsed">
                        <ProgressRing Width="20" Height="20" IsActive="True" />
                        <TextBlock x:Name="LoadingMoreText" Text="Загрузка следующей страницы модов..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Пустое состояние каталога -->
                    <Border x:Name="EmptySearchBorder"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="32"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" Spacing="10">
                            <FontIcon Glyph="&#xE896;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptySearchStatusText" Text="Введите название мода в строку поиска и нажмите «Найти»" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================== ВКЛАДКА 2: УСТАНОВЛЕННЫЕ МОДЫ ================== -->
                <StackPanel x:Name="InstalledViewPanel" Spacing="16" Visibility="Collapsed">
                    <!-- Панель быстрых действий над установленными модами -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="InstalledSearchBox"
                                     PlaceholderText="Фильтр по установленным модам..."
                                     Height="38"
                                     TextChanged="InstalledSearchBox_TextChanged"
                                     MaxWidth="400"
                                     HorizontalAlignment="Left" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <Button Click="RefreshInstalledBtn_Click" Height="38" Padding="14,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                        <TextBlock x:Name="RefreshInstalledBtnText" Text="Обновить" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OpenModsFolderBtn_Click" Height="38" Padding="14,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xED25;" FontSize="14" />
                                        <TextBlock x:Name="OpenInstalledFolderBtnText" Text="Открыть папку" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="DeleteAllModsBtn_Click" Height="38" Padding="14,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#FF5555" />
                                        <TextBlock x:Name="DeleteAllModsBtnText" Text="Удалить все" Foreground="#FF5555" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="InstalledHeaderText" Text="Установленные моды" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <!-- Список установленных модов -->
                    <StackPanel x:Name="InstalledModsPanel" Spacing="8" />

                    <!-- Пустое состояние установленных модов -->
                    <Border x:Name="EmptyInstalledBorder"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="36"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <FontIcon Glyph="&#xED25;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyInstalledTitle" Text="В этой сборке пока нет установленных модов" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyInstalledDesc" Text="Перейдите на вкладку «Каталог модов» или установите пакет ускорения в 1 клик!" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="EmptyInstalledCatalogBtn" Content="Перейти в каталог модов" Click="TabCatalogBtn_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================== ВКЛАДКА 3: 1-КЛИК УСКОРИТЕЛЬ FPS ================== -->
                <StackPanel x:Name="BoosterViewPanel" Spacing="16" Visibility="Collapsed">
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="28">
                        <StackPanel Spacing="16">
                            <Grid>
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE945;" FontSize="24" Foreground="#FFD700" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BoosterHeaderTitle" Text="1-Клик Ускоритель FPS (Aurora FastEngine)" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="BoosterTargetText" Text="Рекомендуемый стек для вашей сборки" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="BoosterPackTitle" Text="Пакет экстремального FPS (Sodium + Lithium + FerriteCore)" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="BoosterPackDesc" Text="Автоматически оптимизирует рендеринг чанков, снижает потребление оперативной памяти на 40% и убирает микрофризы." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Панель статуса и кнопки Установки/Удаления пакета оптимизации -->
                            <StackPanel Spacing="12">
                                <Border x:Name="BoosterInstalledNotice" Background="#1A107C41" BorderBrush="#107C41" BorderThickness="1" CornerRadius="8" Padding="14,10" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="#107C41" />
                                        <TextBlock x:Name="BoosterInstalledNoticeText" Text="Пакет экстремального FPS уже установлен и активно ускоряет эту сборку!" FontWeight="SemiBold" Foreground="#107C41" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="InstallFpsPackBtn" Click="InstallFpsPackBtn_Click" Background="#107C41" Foreground="White" Height="48" Padding="28,0">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE945;" FontSize="18" Foreground="#FFD700" />
                                            <TextBlock x:Name="InstallFpsPackBtnText" Text="⚡ Установить пакет оптимизации в 1 клик" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="UninstallFpsPackBtn" Click="UninstallFpsPackBtn_Click" Height="48" Padding="24,0" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="#FF5555" />
                                            <TextBlock x:Name="UninstallFpsPackBtnText" Text="Удалить пакет оптимизации" Foreground="#FF5555" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel x:Name="BoosterProgressPanel" Spacing="6" Visibility="Collapsed">
                                    <TextBlock x:Name="BoosterStatusText" Text="Установка компонентов оптимизации..." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ProgressBar x:Name="BoosterProgressBar" IsIndeterminate="True" Height="4" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
