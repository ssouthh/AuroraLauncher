<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuroraLauncher.Pages.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="36,24,36,36" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1064" Spacing="24">

            <!-- Заголовок страницы -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="AccountsPageTitle" Style="{ThemeResource TitleTextBlockStyle}" Text="Аккаунты и авторизация" />
                <TextBlock x:Name="AccountsPageSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource BodyTextBlockStyle}" Text="Управление учетными записями Minecraft Java Edition и официальный вход Microsoft" TextWrapping="Wrap" />
            </StackPanel>

            <!-- InfoBar для уведомлений -->
            <InfoBar x:Name="AccountInfoBar" IsOpen="False" IsClosable="True" />

            <!-- Текущий активный профиль -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="CurrentProfileHeaderTitle" Text="Текущий профиль" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Аватарка -->
                        <Border x:Name="AvatarBorder"
                                Width="56"
                                Height="56"
                                CornerRadius="28"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                Margin="0,0,18,0">
                            <FontIcon x:Name="AvatarGlyph" Glyph="&#xE77B;" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>

                        <!-- Инфо -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="ProfileUsernameText" Text="Не выполнен вход" Style="{ThemeResource TitleTextBlockStyle}" FontSize="20" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <Border x:Name="ProfileBadgeBorder"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="ProfileBadgeText" Text="Нет аккаунта" Style="{ThemeResource CaptionTextBlockStyle}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="ProfileUuidText" Text="Войдите через Microsoft или создайте локальный профиль" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Действия с текущим аккаунтом -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="RefreshAccountBtn" Click="RefreshAccountBtn_Click" Content="Обновить токен" Visibility="Collapsed" />
                            <Button x:Name="LogoutAccountBtn" Click="LogoutAccountBtn_Click" Content="Выйти" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Карточка: Импорт лицензии из Modrinth App -->
            <Border x:Name="ModrinthImportCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="ModrinthImportTitle" Text="Обнаружена лицензия Minecraft в лаунчерах на ПК!" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="ModrinthImportDescText"
                                   Text="Вы уже авторизованы в Modrinth App на этом компьютере. Нажмите кнопку, чтобы войти в один клик с официальной лицензией без паролей."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="ImportFromModrinthBtn"
                            Grid.Column="1"
                            Click="ImportFromModrinthBtn_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            Height="42"
                            Padding="20,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="15" />
                            <TextBlock x:Name="ImportFromModrinthBtnText" Text="Импортировать профиль" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Карточка: Официальный вход Microsoft -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="MicrosoftAuthTitle" Text="Официальная авторизация Microsoft" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="MicrosoftAuthDesc" Text="Безопасный официальный вход через Microsoft OAuth. Вход подтверждается напрямую на защищённом сайте Microsoft." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Предупреждение о ненастроенном Client ID -->
                    <InfoBar x:Name="MissingClientIdBar"
                             IsOpen="False"
                             IsClosable="True"
                             Severity="Informational"
                             Title="Microsoft OAuth Client ID"
                             Message="Для авторизации по Device Code или собственному приложению укажите Client ID в Настройках («Аккаунты и API») или через переменную окружения AURORA_MS_CLIENT_ID. Пошаговая инструкция доступна в разделе «О лаунчере»." />

                    <!-- Начальное состояние: кнопка входа -->
                    <StackPanel x:Name="MicrosoftStartSection" Orientation="Horizontal" Spacing="12">
                        <Button x:Name="StartDeviceLoginBtn" Click="StartDeviceLoginBtn_Click" Style="{ThemeResource AccentButtonStyle}" Height="40" Padding="20,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE77B;" FontSize="16" />
                                <TextBlock x:Name="StartDeviceLoginBtnText" Text="Войти через Microsoft" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Интерактивный процесс авторизации по Device Code -->
                    <Border x:Name="MicrosoftFlowSection"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Visibility="Collapsed">
                        <StackPanel Spacing="18">
                            <TextBlock x:Name="DeviceCodeStepsTitle" Text="Шаги для входа по коду устройства:" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                            <!-- Шаг 1 и код -->
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="DeviceStep1Text" Text="1. Скопируйте этот одноразовый код:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="2"
                                            CornerRadius="6"
                                            Padding="18,8">
                                        <TextBlock x:Name="UserCodeDisplay"
                                                   Text="---- ----"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   CharacterSpacing="140"
                                                   IsTextSelectionEnabled="True"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <Button x:Name="CopyCodeBtn" Click="CopyCodeBtn_Click" Height="44" Padding="14,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                            <TextBlock x:Name="CopyCodeBtnText" Text="Скопировать код" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Шаг 2 и ссылка -->
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="DeviceStep2Text" Text="2. Перейдите на страницу авторизации Microsoft и вставьте скопированный код:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Button x:Name="OpenBrowserLinkBtn" Click="OpenBrowserLinkBtn_Click" Style="{ThemeResource AccentButtonStyle}" Height="38" Padding="16,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                        <TextBlock x:Name="OpenBrowserLinkBtnText" Text="Открыть microsoft.com/link в браузере" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Статус поллинга -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="6"
                                    Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ProgressRing x:Name="MsPollingRing" Width="18" Height="18" IsActive="True" Margin="0,0,12,0" />
                                    <TextBlock x:Name="MsPollingStatusText" Grid.Column="1" Text="Ожидание ввода кода и подтверждения в браузере..." VerticalAlignment="Center" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                    <Button x:Name="CancelMsLoginBtn" Grid.Column="2" Click="CancelMsLoginBtn_Click" Content="Отмена" Padding="12,4" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
