<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AuroraLauncher.Pages.JavaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="36,24,36,36" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1064" Spacing="24">

            <!-- Заголовок страницы -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="JavaPageTitle" Style="{ThemeResource TitleTextBlockStyle}" Text="Среда Java Runtime" />
                <TextBlock x:Name="JavaPageSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource BodyTextBlockStyle}" Text="Управление установками Java и автоматический выбор версии под Minecraft" TextWrapping="Wrap" />
            </StackPanel>

            <!-- InfoBar для уведомлений -->
            <InfoBar x:Name="JavaInfoBar" IsOpen="False" IsClosable="True" />

            <!-- Текущая активная Java -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="CurrentJavaHeaderTitle" Text="Используемая Java" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="ActiveJavaText" Text="Автоматический выбор (лаунчер сам выберет или скачает подходящую Java от Mojang/Adoptium)" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ActiveJavaPathText" Text="" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Button x:Name="ResetJavaBtn" Click="ResetJavaBtn_Click" Content="Сбросить на автоматический выбор" />
                </StackPanel>
            </Border>

            <!-- Поиск Java -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="ScanHeaderTitle" Text="Поиск установок на компьютере" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="ScanHeaderSubtitle" Text="Быстрый поиск проверяет переменные JAVA_HOME, PATH, системный реестр и стандартные папки программ. Глубокое сканирование ищет javaw.exe по всем локальным дискам." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="QuickScanBtn" Click="QuickScanBtn_Click" Style="{ThemeResource AccentButtonStyle}" Height="38" Padding="18,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                <TextBlock x:Name="QuickScanBtnText" Text="Быстрое сканирование" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="DeepScanBtn" Click="DeepScanBtn_Click" Height="38" Padding="18,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEC50;" FontSize="14" />
                                <TextBlock x:Name="DeepScanBtnText" Text="Глубокое сканирование дисков" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Статус сканирования -->
                    <StackPanel x:Name="ScanStatusSection" Spacing="8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing x:Name="ScanRing" Width="18" Height="18" IsActive="True" />
                            <TextBlock x:Name="ScanStatusText" Text="Сканирование..." VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Официальные рантаймы Mojang -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="MojangRuntimesTitle" Text="Официальные рантаймы от Mojang" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="MojangRuntimesSubtitle" Text="Если у вас нет нужной Java для современных версий Minecraft или модов, лаунчер может скачать чистый официальный JDK прямо от серверов Mojang." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="DownloadJava25Btn" Click="DownloadJava25Btn_Click" Style="{ThemeResource AccentButtonStyle}" Height="38" Padding="16,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock x:Name="DownloadJava25BtnText" Text="Скачать Java 25 (для 26.3+ / снапшотов)" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="DownloadJava21Btn" Click="DownloadJava21Btn_Click" Height="38" Padding="16,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock x:Name="DownloadJava21BtnText" Text="Скачать Java 21 (для 1.20.5+ / 1.21)" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="DownloadJava17Btn" Click="DownloadJava17Btn_Click" Height="38" Padding="16,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock x:Name="DownloadJava17BtnText" Text="Скачать Java 17 (для 1.18 – 1.20.4)" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Прогресс скачивания официальной Java -->
                    <StackPanel x:Name="DownloadJavaProgressSection" Spacing="8" Visibility="Collapsed">
                        <Grid>
                            <TextBlock x:Name="DownloadJavaStatusText" Text="Загрузка Java..." Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="DownloadJavaPercentText" Text="0%" HorizontalAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ProgressBar x:Name="DownloadJavaProgressBar" Height="6" Minimum="0" Maximum="100" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Список найденных Java -->
            <StackPanel Spacing="12">
                <TextBlock x:Name="FoundJavaHeaderTitle" Text="Найденные версии Java" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <StackPanel x:Name="JavaListPanel" Spacing="8" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
